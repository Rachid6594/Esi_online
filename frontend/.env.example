# Configuration du front ESI-Online.
#
# Copier en .env.local (Vite ne lit que les préfixes VITE_*, et le fichier
# doit être dans frontend/).
#
#   cp .env.example .env.local
#
# Toutes les variables exposedes ici arrivent dans le bundle du navigateur :
# ne jamais y mettre de secret.

# Racine de l'API Django. Vide = même origine, ce qui est le cas en
# production quand nginx sert le front et l'API sur le même domaine.
# En développement, le front tourne sur :3000 et Django sur :8000 :
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=
