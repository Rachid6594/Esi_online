# Configuration du backend ESI-Online.
#
# Copier ce fichier en .env et le remplir. En developpement il suffit de
# garder les valeurs par defaut ; en production, DEBUG=false refuse de
# demarrer tant que SECRET_KEY et ALLOWED_HOSTS sont restees par defaut.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Le fichier .env n'est jamais versionne.

# ---------------------------------------------------------------------------
# Sécurité
# ---------------------------------------------------------------------------

# Obligatoire en production. Générer une valeur avec :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changez-moi-avec-secrets-token-urlsafe-64

# false en production : laisse fuiter les pages de trace Django.
# false force aussi CORS_ALLOW_ALL_ORIGINS à false.
DEBUG=true

# Domaines servis, séparés par des virgules. En production, mettre le nom de
# domaine réel : "localhost" seul fait échouer le démarrage.
ALLOWED_HOSTS=localhost,127.0.0.1

# Mot de passe du superutilisateur « admin » créé à la première migration.
# Sans cette variable, la migration utilise une valeur par défaut connue.
# En production : obligatoire et fort.
# ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# Base de données (PostgreSQL)
# ---------------------------------------------------------------------------

# "postgresql" active PostgreSQL (variables DB_* ci-dessous) ; "sqlite" est la
# valeur par défaut pour le développement local. Voir deployment/README.md.
DB_ENGINE=postgresql
DB_NAME=esi_online
DB_USER=esi
DB_PASSWORD=
# Socket Unix à /var/run/postgresql, ou adresse TCP.
DB_HOST=/var/run/postgresql
DB_PORT=5432

# ---------------------------------------------------------------------------
# Fichiers déposés
# ---------------------------------------------------------------------------

# Doit pointer hors du dépôt git en production, pour qu'un git pull ne
# puisse pas remplacer les documents téléversés. Voir deployment/README.md.
MEDIA_ROOT=./media

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# true uniquement en developpement (le front Vite tourne sur un autre port).
# Aucune origine a renseigner en production : nginx sert front et API sur le
# meme domaine (meme origine). N'ouvrir CORS_ALLOWED_ORIGINS que si les deux
# etaient separes.
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=https://esi.example.dz

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# Origine du front, utilisée pour les liens dans les emails.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# EMAIL_HOST vide => les emails s'affichent dans la console du serveur.
# Renseigner les quatre variables ci-dessous pour un vrai SMTP (Brevo,
# Sendinblue, Gmail...).
# EMAIL_HOST=smtp.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@esi.bf

# ---------------------------------------------------------------------------
# Internationalisation
# ---------------------------------------------------------------------------

LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Algiers

# ---------------------------------------------------------------------------
# HTTPS — à n'activer qu'une fois le certificat certbot installé
# ---------------------------------------------------------------------------
# Tout est à false par défaut, et c'est volontaire. Rediriger vers HTTPS avant
# que le certificat existe rend le site injoignable, et HSTS est irréversible :
# un navigateur qui l'a mémorisé refuse le HTTP ensuite, même si le certificat
# saute. Voir deployment/README.md.

# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
